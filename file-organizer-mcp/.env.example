MCP_SERVER_NAME=file-organizer-bertopic
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=INFO

RECURSIVE=false
SUPPORTED_EXTENSIONS=.pdf,.txt,.md,.docx,.json,.html,.htm,.xml,.pptx,.xlsx,.epub
MAX_FILES_PER_REQUEST=1000
MAX_FILE_SIZE_MB=100
MIN_EXTRACTED_CHARACTERS=40

EMBEDDING_MODEL_PATH=/Users/utsabshrestha/code/github/assist/nomic-embed-text-v1.5.Q6_K.gguf
EMBEDDING_TASK_PREFIX=clustering:
N_CTX=2048
BATCH_SIZE=512
GPU_LAYERS=-1
THREADS=

CHUNK_TOKENS=1024
CHUNK_OVERLAP=128
MAX_CHUNKS_PER_FILE=12
MAX_PAGES=0
CTFIDF_MAX_CHARS=100000

MIN_TOPIC_SIZE=3
MIN_DF=1
MAX_DF=1.0
TOP_TERMS=10
LANGUAGE=english
NGRAM_MIN=1
NGRAM_MAX=2
UMAP_N_NEIGHBORS=auto
UMAP_N_COMPONENTS=auto
UMAP_MIN_DIST=0.0
UMAP_METRIC=cosine
UMAP_RANDOM_STATE=42
HDBSCAN_MIN_CLUSTER_SIZE=auto
HDBSCAN_METRIC=euclidean
HDBSCAN_CLUSTER_SELECTION_METHOD=eom
HDBSCAN_PREDICTION_DATA=true
CALCULATE_PROBABILITIES=true
CTFIDF_BM25_WEIGHTING=true
CTFIDF_REDUCE_FREQUENT_WORDS=true

CACHE_ENABLED=true
CACHE_DIR=./cache/embeddings
CACHE_EXPIRATION_DAYS=30
CACHE_CLEANUP_INTERVAL_HOURS=24
FORCE_REEMBED=false

MAX_QUEUED_JOBS=5
QUEUE_WAIT_TIMEOUT_SECONDS=1800
REQUEST_PROCESSING_TIMEOUT_SECONDS=3600

# Agentic evaluated-run storage
RESULT_TTL_MINUTES=30
MAX_STORED_RUNS=20
